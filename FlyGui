-- Biến điều khiển Fly chuẩn
local isFlying = false
local flySpeed = 50
local verticalVelocity = 0
local bodyGyro, bodyVelocity
local flyConnection

local function startFlySystem()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	local root = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	
	-- Xóa các lực cơ học cũ nếu có
	if bodyGyro then bodyGyro:Destroy() end
	if bodyVelocity then bodyVelocity:Destroy() end
	
	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.P = 9e4
	bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
	bodyGyro.cframe = root.CFrame
	bodyGyro.Parent = root
	
	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.velocity = Vector3.new(0, 0, 0)
	bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
	bodyVelocity.Parent = root
	
	if hum then
		hum.PlatformStand = true
	end

	flyConnection = RunService.RenderStepped:Connect(function()
		if not isFlying or not char or not root then return end
		
		local moveDir = Vector3.new(0, 0, 0)
		if hum then
			moveDir = hum.MoveDirection
		end
		
		-- Tính toán hướng bay theo Camera & Joystick / Nút phím
		local targetVelocity = Vector3.new(0, 0, 0)
		if moveDir.Magnitude > 0 then
			targetVelocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * flySpeed
		end
		
		-- Kết hợp bay tự do + nút bay Lên/Xuống
		bodyVelocity.velocity = Vector3.new(targetVelocity.X, verticalVelocity, targetVelocity.Z)
		bodyGyro.cframe = camera.CFrame
	end)
end

local function stopFlySystem()
	isFlying = false
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
	
	local char = LocalPlayer.Character
	if char and char:FindFirstChildOfClass("Humanoid") then
		char:FindFirstChildOfClass("Humanoid").PlatformStand = false
	end
end

-- Logic Sự Kiện Buttons
FlyToggleBtn.MouseButton1Click:Connect(function()
	isFlying = not isFlying
	if isFlying then
		FlyToggleBtn.Text = "Tắt Fly"
		FlyToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
		FlyControlFrame.Visible = true
		startFlySystem()
	else
		FlyToggleBtn.Text = "Bật Fly"
		FlyToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
		FlyControlFrame.Visible = false
		stopFlySystem()
	end
end)

ToggleButton.MouseButton1Click:Connect(function()
	MainFrame.Visible = not MainFrame.Visible
	if not MainFrame.Visible then
		FlyControlFrame.Visible = false
	elseif isFlying then
		FlyControlFrame.Visible = true
	end
end)

CloseBtn.MouseButton1Click:Connect(function()
