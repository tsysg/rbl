end)

mine.MouseButton1Down:Connect(function()
	if speeds > 1 then
		speeds = speeds - 1
		speed.Text = tostring(speeds)
	else
		speed.Text = "Min 1"
		task.wait(1)
		speed.Text = tostring(speeds)
	end
end)

