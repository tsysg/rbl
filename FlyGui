-- Hàm tạo một dòng chức năng (label + control)
local function createRow(parent, yPos, labelText, controlType, controlData)
    local row = Instance.new("Frame")
    row.Parent = parent
    row.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, -20, 0, 30)
    row.Position = UDim2.new(0.5, 0, yPos, 0)
    row.AnchorPoint = Vector2.new(0.5, 0)
    local rowCorner = Instance.new("UICorner", row)
    rowCorner.CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Parent = row
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Position = UDim2.new(0.05, 0, 0, 0)
    label.Font = Enum.Font.Gotham
    label.Text = labelText
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    local control = nil
    if controlType == "toggle" then
        control = Instance.new("TextButton")
        control.Parent = row
        control.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        control.BorderSizePixel = 0
        control.Size = UDim2.new(0, 50, 1, -4)
        control.Position = UDim2.new(0.75, 0, 0.5, 0)
        control.AnchorPoint = Vector2.new(0, 0.5)
        control.Font = Enum.Font.GothamBold
        control.Text = "OFF"
        control.TextColor3 = Color3.new(1, 1, 1)
        control.TextSize = 12
        local cCorner = Instance.new("UICorner", control)
        cCorner.CornerRadius = UDim.new(0, 6)
        control.Data = controlData or {}
        control.Data.state = false
        control.MouseButton1Click:Connect(function()
            control.Data.state = not control.Data.state
            if control.Data.state then
                control.Text = "ON"
                control.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
            else
                control.Text = "OFF"
                control.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            end
            if control.Data.onToggle then
                control.Data.onToggle(control.Data.state)
            end
        end)
    elseif controlType == "button" then
        control = Instance.new("TextButton")
        control.Parent = row
        control.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        control.BorderSizePixel = 0
        control.Size = UDim2.new(0, 60, 1, -4)
        control.Position = UDim2.new(0.75, 0, 0.5, 0)
        control.AnchorPoint = Vector2.new(0, 0.5)
        control.Font = Enum.Font.GothamBold
        control.Text = controlData.text or "Click"
        control.TextColor3 = Color3.new(1, 1, 1)
        control.TextSize = 12
        local cCorner = Instance.new("UICorner", control)
        cCorner.CornerRadius = UDim.new(0, 6)
        control.MouseButton1Click:Connect(function()
            if controlData.onClick then
                controlData.onClick()
            end
        end)
    elseif controlType == "speed" then
        -- Tạo nhóm +, giá trị, -
        local minus = Instance.new("TextButton")
        minus.Parent = row
        minus.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        minus.BorderSizePixel = 0
        minus.Size = UDim2.new(0, 25, 1, -4)
        minus.Position = UDim2.new(0.65, 0, 0.5, 0)
        minus.AnchorPoint = Vector2.new(0, 0.5)
        minus.Font = Enum.Font.GothamBold
        minus.Text = "-"
        minus.TextColor3 = Color3.new(1, 1, 1)
        minus.TextSize = 16
        local mCorner = Instance.new("UICorner", minus)
        mCorner.CornerRadius = UDim.new(0, 6)

        local value = Instance.new("TextLabel")
        value.Parent = row
        value.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        value.BorderSizePixel = 0
        value.Size = UDim2.new(0, 30, 1, -4)
        value.Position = UDim2.new(0.72, 0, 0.5, 0)
        value.AnchorPoint = Vector2.new(0, 0.5)
        value.Font = Enum.Font.GothamBold
        value.Text = "1"
        value.TextColor3 = Color3.new(1, 1, 1)
        value.TextSize = 14
        local vCorner = Instance.new("UICorner", value)
        vCorner.CornerRadius = UDim.new(0, 6)

        local plus = Instance.new("TextButton")
        plus.Parent = row
        plus.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        plus.BorderSizePixel = 0
        plus.Size = UDim2.new(0, 25, 1, -4)
        plus.Position = UDim2.new(0.82, 0, 0.5, 0)
        plus.AnchorPoint = Vector2.new(0, 0.5)
        plus.Font = Enum.Font.GothamBold
        plus.Text = "+"
        plus.TextColor3 = Color3.new(1, 1, 1)
        plus.TextSize = 16
        local pCorner = Instance.new("UICorner", plus)
        pCorner.CornerRadius = UDim.new(0, 6)

        -- Dữ liệu tốc độ
        local speedData = {value = 1}
        minus.MouseButton1Click:Connect(function()
            if speedData.value > 1 then
                speedData.value = speedData.value - 1
                value.Text = tostring(speedData.value)
                if controlData.onChange then
                    controlData.onChange(speedData.value)
                end
            else
                value.Text = "MIN"
                wait(0.3)
                value.Text = tostring(speedData.value)
            end
        end)
        plus.MouseButton1Click:Connect(function()
            speedData.value = speedData.value + 1
            value.Text = tostring(speedData.value)
            if controlData.onChange then
                controlData.onChange(speedData.value)
            end
        end)
        control = {minus = minus, plus = plus, value = value, data = speedData}
    end
    return row, control
end

