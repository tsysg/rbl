-- Hàm cập nhật tốc độ hiển thị
local function updateSpeedDisplay()
	speed.Text = tostring(speeds)
end

-- Hàm bật/tắt fly
local function toggleFly()
	flyingEnabled = not flyingEnabled
	if flyingEnabled then
		onof.Text = "ON"
		onof.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
	else
		onof.Text = "FLY"
		onof.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
	end
end

-- Xử lý fly (giữ nguyên logic từ file gốc, chỉ điều chỉnh)
local function startFly()
	if not flyingEnabled then return end
	-- Tắt các trạng thái humanoid
	local hum = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
	if not hum then return end
	for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
		hum:SetStateEnabled(state, false)
	end
	hum:ChangeState(Enum.HumanoidStateType.Swimming)
	player.Character.Animate.Disabled = true
	hum.PlatformStand = true

	-- Tạo các body objects
	local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
	if not torso then return end
	local bg = Instance.new("BodyGyro", torso)
	bg.P = 9e4
	bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
	local bv = Instance.new("BodyVelocity", torso)
	bv.velocity = Vector3.new(0, 0.1, 0)
	bv.maxForce = Vector3.new(9e9, 9e9, 9e9)

	local ctrl = {f = 0, b = 0, l = 0, r = 0}
	local lastctrl = {f = 0, b = 0, l = 0, r = 0}
	local maxspeed = 50
	local currentSpeed = 0

	-- Hàm xử lý phím
	local function onKeyDown(input, gameProcessed)
		if gameProcessed then return end
		local key = input.KeyCode
		if key == Enum.KeyCode.W then ctrl.f = 1 end
		if key == Enum.KeyCode.S then ctrl.b = -1 end
		if key == Enum.KeyCode.A then ctrl.l = -1 end
		if key == Enum.KeyCode.D then ctrl.r = 1 end
	end
	local function onKeyUp(input, gameProcessed)
		if gameProcessed then return end
		local key = input.KeyCode
		if key == Enum.KeyCode.W then ctrl.f = 0 end
		if key == Enum.KeyCode.S then ctrl.b = 0 end
		if key == Enum.KeyCode.A then ctrl.l = 0 end
		if key == Enum.KeyCode.D then ctrl.r = 0 end
	end
	UserInputService.InputBegan:Connect(onKeyDown)
	UserInputService.InputEnded:Connect(onKeyUp)

	-- Vòng lặp fly
	while flyingEnabled and player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") and player.Character.Humanoid.Health > 0 do
		RunService.Heartbeat:Wait()
		local camera = workspace.CurrentCamera
		if not camera then continue end

		-- Tính tốc độ
		if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
			currentSpeed = currentSpeed + 0.5 + (currentSpeed / maxspeed)
			if currentSpeed > maxspeed then currentSpeed = maxspeed end
		elseif currentSpeed ~= 0 then
			currentSpeed = currentSpeed - 1
			if currentSpeed < 0 then currentSpeed = 0 end
		end

		-- Tính hướng
		local moveDirection = Vector3.new(ctrl.l + ctrl.r, 0, ctrl.f + ctrl.b)
		if moveDirection.Magnitude > 0 then
			local lookVector = camera.CFrame.LookVector
			local rightVector = camera.CFrame.RightVector
			local upVector = camera.CFrame.UpVector
			local velocity = (lookVector * (ctrl.f + ctrl.b) + rightVector * (ctrl.l + ctrl.r)) * currentSpeed
			bv.velocity = velocity
			lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
		elseif currentSpeed ~= 0 then
			local vel = (camera.CFrame.LookVector * (lastctrl.f + lastctrl.b) + camera.CFrame.RightVector * (lastctrl.l + lastctrl.r)) * currentSpeed
			bv.velocity = vel
		else
			bv.velocity = Vector3.new(0, 0, 0)
		end

		bg.cframe = camera.CFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * currentSpeed / maxspeed), 0, 0)
	end

	-- Dọn dẹp khi tắt fly
	bg:Destroy()
	bv:Destroy()
	hum.PlatformStand = false
	player.Character.Animate.Disabled = false
	-- Bật lại các state
	for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
		hum:SetStateEnabled(state, true)
	end
	hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
end

