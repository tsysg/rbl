-- Logic Fly (giữ nguyên từ file gốc, cải tiến)
local flyThread = nil

function toggleFlyFunction(state)
    if state then
        if flyThread then return end
        flyThread = coroutine.create(function()
            -- Kiểm tra Rig
            local hum = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
            if not hum then return end
            local rigType = hum.RigType
            local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
            if not torso then return end

            -- Tắt các state
            for _, stateEnum in pairs(Enum.HumanoidStateType:GetEnumItems()) do
                hum:SetStateEnabled(stateEnum, false)
            end
            hum:ChangeState(Enum.HumanoidStateType.Swimming)
            player.Character.Animate.Disabled = true
            hum.PlatformStand = true

            -- Tạo BodyGyro và BodyVelocity
            local bg = Instance.new("BodyGyro", torso)
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.cframe = torso.CFrame
            local bv = Instance.new("BodyVelocity", torso)
            bv.velocity = Vector3.new(0, 0.1, 0)
            bv.maxForce = Vector3.new(9e9, 9e9, 9e9)

            local ctrl = {f = 0, b = 0, l = 0, r = 0}
            local lastctrl = {f = 0, b = 0, l = 0, r = 0}
            local maxspeed = 50
            local currentSpeed = 0

            -- Xử lý phím
            local keyDownCon, keyUpCon
            keyDownCon = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                local key = input.KeyCode
                if key == Enum.KeyCode.W then ctrl.f = 1 end
                if key == Enum.KeyCode.S then ctrl.b = -1 end
                if key == Enum.KeyCode.A then ctrl.l = -1 end
                if key == Enum.KeyCode.D then ctrl.r = 1 end
            end)
            keyUpCon = UserInputService.InputEnded:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                local key = input.KeyCode
                if key == Enum.KeyCode.W then ctrl.f = 0 end
                if key == Enum.KeyCode.S then ctrl.b = 0 end
                if key == Enum.KeyCode.A then ctrl.l = 0 end
                if key == Enum.KeyCode.D then ctrl.r = 0 end
            end)

            -- Vòng lặp chính
            while flyingEnabled and player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") and player.Character.Humanoid.Health > 0 do
                RunService.Heartbeat:Wait()
                local camera = workspace.CurrentCamera
                if not camera then continue end

                -- Tốc độ
                if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
                    currentSpeed = currentSpeed + 0.5 + (currentSpeed / maxspeed)
                    if currentSpeed > maxspeed then currentSpeed = maxspeed end
                elseif currentSpeed ~= 0 then
                    currentSpeed = currentSpeed - 1
                    if currentSpeed < 0 then currentSpeed = 0 end
                end

                -- Hướng di chuyển
                local moveVec = Vector3.new(ctrl.l + ctrl.r, 0, ctrl.f + ctrl.b)
                if moveVec.Magnitude > 0 then
                    local look = camera.CFrame.LookVector
                    local right = camera.CFrame.RightVector
                    local vel = (look * (ctrl.f + ctrl.b) + right * (ctrl.l + ctrl.r)) * currentSpeed
                    bv.velocity = vel
                    lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
                elseif currentSpeed ~= 0 then
                    local look = camera.CFrame.LookVector
                    local right = camera.CFrame.RightVector
                    local vel = (look * (lastctrl.f + lastctrl.b) + right * (lastctrl.l + lastctrl.r)) * currentSpeed
                    bv.velocity = vel
                else
                    bv.velocity = Vector3.new(0, 0, 0)
                end

                bg.cframe = camera.CFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * currentSpeed / maxspeed), 0, 0)
            end

            -- Dọn dẹp
            bg:Destroy()
            bv:Destroy()
            if keyDownCon then keyDownCon:Disconnect() end
            if keyUpCon then keyUpCon:Disconnect() end
            if player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
                local hum2 = player.Character.Humanoid
                hum2.PlatformStand = false
                for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
                    hum2:SetStateEnabled(state, true)
                end
                hum2:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
            end
            if player.Character and player.Character:FindFirstChild("Animate") then
                player.Character.Animate.Disabled = false
            end
            flyThread = nil
        end)
        coroutine.resume(flyThread)
    else
        -- Tắt fly bằng cách đặt flyingEnabled = false, vòng lặp sẽ tự dừng
        flyingEnabled = false
        -- Đợi thread kết thúc
        if flyThread then
            -- Không cần làm gì thêm, vòng lặp sẽ thoát
        end
        -- Đảm bảo reset trạng thái
        wait(0.1)
        if player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
            local hum = player.Character.Humanoid
            hum.PlatformStand = false
            for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
                hum:SetStateEnabled(state, true)
            end
            hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
        end
        if player.Character and player.Character:FindFirstChild("Animate") then
            player.Character.Animate.Disabled = false
        end
    end
end

