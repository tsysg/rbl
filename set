    -- ============== HÀM CẬP NHẬT UI ==============
    local function updateTrackingUI()
        if not isTracking then
            progressBar.Size = UDim2.new(0, 0, 1, 0)
            timeLabel.Text = "0s / " .. growthDuration .. "s"
            warningLabel.Text = "✅ AN TOÀN"
            warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            infoLabel.Text = "⏳ Sẵn sàng"
            return
        end

        local now = os.clock()
        elapsed = now - plantTime
        local remaining = math.max(0, growthDuration - elapsed)
        local progress = math.min(1, elapsed / growthDuration)

        -- Cập nhật thanh
        progressBar.Size = UDim2.new(progress, 0, 1, 0)

        -- Đổi màu theo mức độ nguy hiểm
        if progress > 0.85 then
            progressBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        elseif progress > 0.6 then
            progressBar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        else
            progressBar.BackgroundColor3 = TREE_DATA[selectedTree] and TREE_DATA[selectedTree].color or Color3.fromRGB(0, 200, 80)
        end

        -- Thời gian
        timeLabel.Text = string.format("%ds / %ds", math.floor(elapsed), growthDuration)

        -- Cảnh báo
        if progress >= 1 then
            warningLabel.Text = "🌳 CÂY ĐÃ CHÍN! THU HOẠCH NGAY!"
            warningLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
            infoLabel.Text = "🔔 Cây đã sẵn sàng thu hoạch!"
        elseif progress > 0.85 then
            warningLabel.Text = "⚡ NGUY HIỂM! SÉT CÓ THỂ ĐÁNH BẤT CỨ LÚC NÀO!"
            warningLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            infoLabel.Text = "⚠️ Cảnh báo cực kỳ nguy hiểm! Hãy thu hoạch sớm!"
        elseif progress > 0.6 then
            warningLabel.Text = "⚠️ CẨN THẬN! SÉT CÓ THỂ ĐÁNH!"
            warningLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            infoLabel.Text = "⚡ Khả năng sét đánh tăng cao"
        else
            warningLabel.Text = "✅ AN TOÀN - Cây đang phát triển"
            warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            infoLabel.Text = "🌱 Đang phát triển, an toàn"
        end

        -- Cập nhật trạng thái cây
        if progress >= 1 then
            -- Nếu đã quá thời gian mà chưa thu hoạch thì cảnh báo đặc biệt
        end
    end

    -- ============== HÀM ĐIỀU KHIỂN ==============

    -- Bắt đầu theo dõi
    local function startTracking()
        if isTracking then return end
        -- Lấy thời gian hiện tại
        plantTime = os.clock()
        elapsed = 0
        isTracking = true
        isHarvested = false
        lightningStrikeTime = nil
        infoLabel.Text = "🌱 Bắt đầu theo dõi cây..."

        -- Cập nhật liên tục
        spawn(function()
            while isTracking do
                updateTrackingUI()
                task.wait(0.3)
            end
        end)
    end

    -- Dừng theo dõi (reset)
    local function stopTracking()
        isTracking = false
        elapsed = 0
        plantTime = 0
        progressBar.Size = UDim2.new(0, 0, 1, 0)
        timeLabel.Text = "0s / " .. growthDuration .. "s"
        warningLabel.Text = "✅ AN TOÀN"
        warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        infoLabel.Text = "⏳ Đã dừng"
    end

    -- Thu hoạch
    local function harvest()
        if isTracking and not isHarvested then
            isHarvested = true
            isTracking = false
            local totalTime = os.clock() - plantTime
            infoLabel.Text = "💰 Đã thu hoạch sau " .. string.format("%.1f", totalTime) .. " giây!"
            warningLabel.Text = "💰 THU HOẠCH THÀNH CÔNG!"
            warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            progressBar.Size = UDim2.new(1, 0, 1, 0)
            timeLabel.Text = string.format("%ds / %ds", math.floor(totalTime), growthDuration)
        else
            infoLabel.Text = "⚠️ Chưa có cây để thu hoạch!"
        end
    end

    -- Mô phỏng sét đánh (gọi khi có sự kiện sét)
    local function onLightningStrike()
        if isTracking and not isHarvested then
            isTracking = false
            lightningStrikeTime = os.clock()
            warningLabel.Text = "💥 SÉT ĐÁNH! CÂY ĐÃ BỊ HỎNG!"
            warningLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            infoLabel.Text = "💀 Cây đã bị sét đánh! Mất cây!"
            progressBar.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            print("[Dự báo sét] Cây bị sét đánh sau " .. string.format("%.1f", os.clock() - plantTime) .. " giây")
        end
    end

    -- Gán nút
    startBtn.MouseButton1Click:Connect(startTracking)
    stopBtn.MouseButton1Click:Connect(stopTracking)
    harvestBtn.MouseButton1Click:Connect(harvest)

    -- ============== PHÍM TẮT ==============
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then -- R để bắt đầu
            startTracking()
        elseif input.KeyCode == Enum.KeyCode.T then -- T để thu hoạch
            harvest()
        elseif input.KeyCode == Enum.KeyCode.Escape then -- ESC để đóng
            screenGui:Destroy()
        end
    end)

    -- ============== TRẢ VỀ CÁC HÀM ==============
    return {
        startTracking = startTracking,
        stopTracking = stopTracking,
        harvest = harvest,
        onLightningStrike = onLightningStrike,
        setGrowthTime = function(time)
            growthDuration = time
        end,
        getStatus = function()
            return isTracking, elapsed, growthDuration
        end
    }
end

