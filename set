    -- Cập nhật UI khi đếm ngược
    local function updateCountdownUI()
        if not isCountingDown then
            timeLeftLabel.Text = growthDuration .. "s"
            progressBar.Size = UDim2.new(1, 0, 1, 0)
            warningLabel.Text = "✅ SẴN SÀNG"
            warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            infoLabel.Text = "⏳ Chọn cây và nhấn TRỒNG"
            return
        end

        local elapsed = os.clock() - startTime
        local remaining = math.max(0, growthDuration - elapsed)
        timeLeft = math.ceil(remaining)
        timeLeftLabel.Text = timeLeft .. "s"

        -- Cập nhật thanh tiến trình (từ 1 về 0)
        local progress = remaining / growthDuration
        progressBar.Size = UDim2.new(progress, 0, 1, 0)

        -- Đổi màu theo thời gian còn lại
        if progress < 0.15 then
            progressBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            warningLabel.Text = "⚡ SÉP SẮP ĐÁNH! CHỈ CÒN " .. timeLeft .. "s!"
            warningLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            infoLabel.Text = "⚠️ CỰC KỲ NGUY HIỂM! THU HOẠCH NGAY!"
        elseif progress < 0.4 then
            progressBar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            warningLabel.Text = "⚠️ CẨN THẬN! CÒN " .. timeLeft .. "s"
            warningLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            infoLabel.Text = "⚡ Sét sẽ đánh sau " .. timeLeft .. " giây nữa"
        else
            progressBar.BackgroundColor3 = TREE_DATA[selectedTree] and TREE_DATA[selectedTree].color or Color3.fromRGB(0, 200, 80)
            warningLabel.Text = "🌱 Cây đang phát triển... " .. timeLeft .. "s"
            warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            infoLabel.Text = "⏳ Còn " .. timeLeft .. " giây trước khi sét đánh"
        end

        -- Nếu hết giờ -> sét đánh
        if remaining <= 0 and isCountingDown and not isHarvested then
            isCountingDown = false
            lightningStrike()
        end
    end

    -- Sự kiện sét đánh
    local function lightningStrike()
        warningLabel.Text = "💥 SÉT ĐÁNH! CÂY ĐÃ BỊ HỎNG!"
        warningLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        timeLeftLabel.Text = "💀"
        progressBar.Size = UDim2.new(0, 0, 1, 0)
        progressBar.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        infoLabel.Text = "💀 Cây đã bị sét đánh! Bạn đã mất cây!"
        isHarvested = true
        isCountingDown = false
        print("[Đếm ngược sét] Sét đánh sau đúng " .. growthDuration .. " giây")
    end

    -- Vòng lặp cập nhật UI liên tục
    local function startCountdownLoop()
        if countingDownConnection then
            countingDownConnection:Disconnect()
            countingDownConnection = nil
        end
        countingDownConnection = RunService.Heartbeat:Connect(function()
            updateCountdownUI()
        end)
    end

    -- ============== HÀM ĐIỀU KHIỂN ==============

    -- Trồng cây (bắt đầu đếm ngược)
    local function plantTree()
        if isCountingDown then
            infoLabel.Text = "⚠️ Đã có cây đang trồng!"
            return
        end
        -- Reset trạng thái
        isHarvested = false
        startTime = os.clock()
        isCountingDown = true
        infoLabel.Text = "🌱 Đã trồng cây! Sét sẽ đánh sau " .. growthDuration .. "s"
        warningLabel.Text = "🌱 Cây đang phát triển..."
        warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        timeLeft = growthDuration
        timeLeftLabel.Text = timeLeft .. "s"
        progressBar.Size = UDim2.new(1, 0, 1, 0)
        -- Bắt đầu vòng lặp cập nhật
        startCountdownLoop()
        print("[Đếm ngược sét] Đã trồng cây, sét sẽ đánh sau " .. growthDuration .. " giây")
    end

    -- Dừng (reset)
    local function stopPlant()
        isCountingDown = false
        isHarvested = false
        if countingDownConnection then
            countingDownConnection:Disconnect()
            countingDownConnection = nil
        end
        timeLeft = growthDuration
        timeLeftLabel.Text = timeLeft .. "s"
        progressBar.Size = UDim2.new(1, 0, 1, 0)
        warningLabel.Text = "✅ ĐÃ DỪNG"
        warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        infoLabel.Text = "⏳ Đã dừng, nhấn TRỒNG để bắt đầu lại"
        progressBar.BackgroundColor3 = TREE_DATA[selectedTree] and TREE_DATA[selectedTree].color or Color3.fromRGB(0, 200, 80)
    end

    -- Thu hoạch (nếu chưa bị sét đánh)
    local function harvest()
        if isHarvested then
            infoLabel.Text = "⚠️ Cây đã bị sét đánh hoặc đã thu hoạch!"
            return
        end
        if not isCountingDown then
            infoLabel.Text = "⚠️ Chưa có cây để thu hoạch!"
            return
        end
        -- Thu hoạch thành công
        isCountingDown = false
        isHarvested = true
        if countingDownConnection then
            countingDownConnection:Disconnect()
            countingDownConnection = nil
        end
        local elapsed = os.clock() - startTime
        warningLabel.Text = "💰 THU HOẠCH THÀNH CÔNG!"
        warningLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        timeLeftLabel.Text = "💰"
        progressBar.Size = UDim2.new(0, 0, 1, 0)
        progressBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        infoLabel.Text = "💰 Đã thu hoạch sau " .. string.format("%.1f", elapsed) .. " giây"
        print("[Đếm ngược sét] Thu hoạch thành công sau " .. string.format("%.1f", elapsed) .. " giây")
    end

    -- Gán nút
    startBtn.MouseButton1Click:Connect(plantTree)
    stopBtn.MouseButton1Click:Connect(stopPlant)
    harvestBtn.MouseButton1Click:Connect(harvest)

    -- ============== PHÍM TẮT ==============
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then -- R để trồng
            plantTree()
        elseif input.KeyCode == Enum.KeyCode.T then -- T để thu hoạch
            harvest()
        elseif input.KeyCode == Enum.KeyCode.S then -- S để dừng
            stopPlant()
        elseif input.KeyCode == Enum.KeyCode.Escape then -- ESC để đóng
            screenGui:Destroy()
        end
    end)

    -- ============== TRẢ VỀ ==============
    return {
        plantTree = plantTree,
        stopPlant = stopPlant,
        harvest = harvest,
        setGrowthTime = function(time)
            growthDuration = time
            timeLeft = time
            timeLeftLabel.Text = time .. "s"
        end,
        getStatus = function()
            return isCountingDown, timeLeft, growthDuration
        end
    }
end

