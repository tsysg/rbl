-- Logic Đếm ngược
local isCounting = false

local function startCountdown(duration)
    if isCounting then return end
    isCounting = true
    StatusLabel.Text = "⚡ Cảnh báo: Sét sắp đánh!"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
    
    local remaining = duration
    while remaining > 0 do
        TimeLabel.Text = string.format("%02d:%04.1f", math.floor(remaining / 60), remaining % 60)
        task.wait(0.1)
        remaining = remaining - 0.1
    end
    
    TimeLabel.Text = "00:00.0"
    StatusLabel.Text = "⚡ SÉT ĐÃ ĐÁNH!"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    
    -- Hiệu ứng nhấp nháy báo hiệu
    for i = 1, 4 do
        DisplayBox.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        task.wait(0.1)
        DisplayBox.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
        task.wait(0.1)
    end
    
    isCounting = false
end

-- Nút Test
StartBtn.MouseButton1Click:Connect(function()
