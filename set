    task.spawn(function()
        startCountdown(30)
    end)
end)

-- TỰ ĐỘNG BẮT SỰ KIỆN TỪ GAME (Nếu Server có Attribute/Value)
-- Bạn có thể chỉnh sửa lại Workspace.Plants theo cấu trúc thực tế của game:
workspace.ChildAdded:Connect(function(child)
    if child.Name == "Plant" or child:FindFirstChild("LightningTime") then
        local lightningAttr = child:GetAttribute("LightningTime") or child:FindFirstChild("LightningTime")
        if lightningAttr then
            local targetTime = typeof(lightningAttr) == "Instance" and lightningAttr.Value or lightningAttr
            local countdown = targetTime - workspace:GetServerTimeNow()
            if countdown > 0 then
                task.spawn(function()
                    startCountdown(countdown)
                end)
            end
        end
    end
end)
